# ==============================================================================
# HEALORA HEALTHCARE APPLICATION — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in healora_backend/ and populate your secrets.
# NEVER commit real passwords, API secret keys or SMTP credentials to git!

# Django Security
SECRET_KEY=django-insecure-change-this-to-a-strong-secret-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS Frontend Whitelist
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay Payment Gateway Credentials (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==============================================================================
# REAL EMAIL & SMTP CONFIGURATION (For Forgot Password OTP Delivery)
# ==============================================================================
# Option A: Gmail SMTP with 16-character Google App Password (Recommended)
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords" (myaccount.google.com/apppasswords)
# 3. Create an App Name (e.g. "Healora") and generate a 16-character password.
# 4. Paste your Gmail address and 16-character App Password below:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=Healora Health <your_email@gmail.com>
EMAIL_TIMEOUT=10

# Option B: Local Console/Development Email Backend (Prints emails to Django console)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
